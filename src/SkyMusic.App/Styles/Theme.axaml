<!-- 模块：SkyMusic.App 视觉样式 Theme -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource SkyBrushBackground}" />
    <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, Segoe UI" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SkyBrushTextPrimary}" />
  </Style>

  <Style Selector="Border.sky-settings-section">
    <Setter Property="Background" Value="{StaticResource SkyBrushSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource SkyBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SkyCornerCard}" />
    <Setter Property="Padding" Value="20" />
  </Style>
</Styles>
