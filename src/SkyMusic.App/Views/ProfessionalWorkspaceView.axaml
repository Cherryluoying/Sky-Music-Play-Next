<!-- 模块：SkyMusic.App 页面视图 ProfessionalWorkspaceView -->
<UserControl x:Class="SkyMusic.App.Views.ProfessionalWorkspaceView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SkyMusic.App.Controls"
             xmlns:vm="using:SkyMusic.App.ViewModels">
  <Grid RowDefinitions="52,*,40" Margin="16,12,16,16">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
      <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
        <Button Classes="workbench-tool" Content="&#xE768;" ToolTip.Tip="选择" />
        <Button Classes="workbench-tool" Content="&#xE70F;" ToolTip.Tip="铅笔" />
        <Button Classes="workbench-tool" Content="&#xE74D;" ToolTip.Tip="删除" />
        <Button Classes="workbench-tool" Content="&#xE8B0;" ToolTip.Tip="切分" />
        <Button Classes="workbench-tool" Content="&#xE7A7;" ToolTip.Tip="撤销" />
        <Button Classes="workbench-tool" Content="&#xE7A6;" ToolTip.Tip="重做" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
        <Button Theme="{StaticResource SkyIconButtonTheme}" Content="&#xE892;" ToolTip.Tip="回到开始" />
        <Button Theme="{StaticResource SkyPlayButtonTheme}" Content="&#xE768;" ToolTip.Tip="播放" />
        <Button Theme="{StaticResource SkyIconButtonTheme}" Content="&#xE71A;" ToolTip.Tip="循环" />
        <TextBlock Text="120 BPM" Classes="sky-secondary" Margin="12,0,0,0" VerticalAlignment="Center" />
        <TextBlock Text="4/4" Classes="sky-secondary" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="量化" Classes="sky-caption" VerticalAlignment="Center" />
        <ComboBox SelectedIndex="3" Width="84">
          <ComboBoxItem Content="1/4" />
          <ComboBoxItem Content="1/8" />
          <ComboBoxItem Content="1/12" />
          <ComboBoxItem Content="1/16" />
          <ComboBoxItem Content="1/32" />
        </ComboBox>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="224,12,*,12,250">
      <Border Classes="workbench-panel" Padding="12">
        <Grid RowDefinitions="Auto,12,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="轨道" Classes="sky-section-title" />
            <Button Grid.Column="1" Classes="workbench-tool" Content="&#xE710;"
                    Command="{Binding AddTrackCommand}" ToolTip.Tip="添加轨道" />
          </Grid>
          <ItemsControl Grid.Row="2" ItemsSource="{Binding Tracks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:WorkbenchTrackViewModel">
                <Border Margin="0,0,0,6" Padding="9" CornerRadius="6"
                        Background="{StaticResource SkyBrushSurfaceSecondary}">
                  <Grid ColumnDefinitions="5,30,*,Auto" ColumnSpacing="8">
                    <Border Background="{Binding Color}" CornerRadius="3" />
                    <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="sky-caption"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{Binding Name}" Classes="sky-card-title" />
                      <TextBlock Text="{Binding Detail}" Classes="sky-caption" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3">
                      <ToggleButton Content="M" Width="25" Height="25" />
                      <ToggleButton Content="S" Width="25" Height="25" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Grid.Row="3" Theme="{StaticResource SkyCommandButtonTheme}" Content="添加轨道"
                  Command="{Binding AddTrackCommand}" HorizontalAlignment="Stretch" />
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="workbench-panel" ClipToBounds="True">
        <Grid RowDefinitions="32,*,92">
          <Border Background="#182337" BorderBrush="#30415B" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="74,*,*,*,*,*,*,*,*">
              <TextBlock Grid.Column="1" Text="1" Foreground="#9EABC0" Margin="8,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="2" Foreground="#9EABC0" Margin="8,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="3" Foreground="#9EABC0" Margin="8,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="4" Foreground="#9EABC0" Margin="8,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="5" Text="5" Foreground="#9EABC0" Margin="8,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="6" Text="6" Foreground="#9EABC0" Margin="8,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="7" Text="7" Foreground="#9EABC0" Margin="8,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="8" Text="8" Foreground="#9EABC0" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <controls:PianoRollViewport Grid.Row="1" MinHeight="330" />
          <Border Grid.Row="2" Background="#121D2D" BorderBrush="#30415B" BorderThickness="0,1,0,0">
            <Grid Margin="74,10,10,10" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*" ColumnSpacing="6">
              <Border Grid.Column="0" Height="34" VerticalAlignment="Bottom" Background="#4F7DF3" CornerRadius="2" />
              <Border Grid.Column="1" Height="56" VerticalAlignment="Bottom" Background="#7458EA" CornerRadius="2" />
              <Border Grid.Column="2" Height="44" VerticalAlignment="Bottom" Background="#3D9CED" CornerRadius="2" />
              <Border Grid.Column="3" Height="68" VerticalAlignment="Bottom" Background="#7458EA" CornerRadius="2" />
              <Border Grid.Column="4" Height="38" VerticalAlignment="Bottom" Background="#4F7DF3" CornerRadius="2" />
              <Border Grid.Column="5" Height="62" VerticalAlignment="Bottom" Background="#3D9CED" CornerRadius="2" />
              <Border Grid.Column="6" Height="48" VerticalAlignment="Bottom" Background="#7458EA" CornerRadius="2" />
              <Border Grid.Column="7" Height="72" VerticalAlignment="Bottom" Background="#4F7DF3" CornerRadius="2" />
              <Border Grid.Column="8" Height="42" VerticalAlignment="Bottom" Background="#3D9CED" CornerRadius="2" />
              <Border Grid.Column="9" Height="59" VerticalAlignment="Bottom" Background="#7458EA" CornerRadius="2" />
              <Border Grid.Column="10" Height="31" VerticalAlignment="Bottom" Background="#4F7DF3" CornerRadius="2" />
              <Border Grid.Column="11" Height="65" VerticalAlignment="Bottom" Background="#3D9CED" CornerRadius="2" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="4" Classes="workbench-panel" Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Text="检查器" Classes="sky-section-title" />
          <TextBlock Text="轨道名称" Classes="sky-caption" />
          <TextBox Text="Piano" />
          <TextBlock Text="音源" Classes="sky-caption" />
          <ComboBox SelectedIndex="0">
            <ComboBoxItem Content="内置钢琴" />
            <ComboBoxItem Content="VST3" />
            <ComboBoxItem Content="外部 MIDI" />
          </ComboBox>
          <TextBlock Text="音量" Classes="sky-caption" />
          <Slider Minimum="0" Maximum="1" Value="0.82" />
          <TextBlock Text="声像" Classes="sky-caption" />
          <Slider Minimum="-1" Maximum="1" Value="0" />
          <TextBlock Text="力度" Classes="sky-caption" />
          <Slider Minimum="1" Maximum="127" Value="100" />
          <TextBlock Text="游戏编配" Classes="sky-caption" Margin="0,8,0,0" />
          <ComboBox SelectedIndex="0">
            <ComboBoxItem Content="Sky" />
            <ComboBoxItem Content="Genshin" />
            <ComboBoxItem Content="自定义 Profile" />
          </ComboBox>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="4,10,4,0">
      <TextBlock Text="{Binding StatusText}" Classes="sky-caption" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding ProjectSummary}" Classes="sky-caption" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
