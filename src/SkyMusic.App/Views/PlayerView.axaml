<!-- 模块：SkyMusic.App 页面视图 PlayerView -->
<UserControl x:Class="SkyMusic.App.Views.PlayerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SkyMusic.App.Controls">
  <UserControl.Styles>
    <!-- 沉浸背景中的操作图标在普通、悬停和按下状态都保持足够对比度。 -->
    <Style Selector="Button.immersive-icon">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.immersive-icon:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="#24FFFFFF" />
    </Style>
    <Style Selector="Button.immersive-icon:pressed /template/ Border#Root">
      <Setter Property="Background" Value="#38FFFFFF" />
    </Style>
    <Style Selector="Button.immersive-icon:pointerover, Button.immersive-icon:pressed">
      <Setter Property="Foreground" Value="White" />
    </Style>
  </UserControl.Styles>
  <Grid ClipToBounds="True">
    <Border Background="#0B1727" />
    <Image Source="{Binding CurrentItem.Cover}" Stretch="UniformToFill" Opacity="0.72"
           RenderTransformOrigin="50%,50%">
      <Image.Effect>
        <BlurEffect Radius="54" />
      </Image.Effect>
      <Image.RenderTransform>
        <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
      </Image.RenderTransform>
    </Image>
    <Border Background="#A80A1626" />
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Color="#24071220" Offset="0" />
          <GradientStop Color="#72071220" Offset="0.58" />
          <GradientStop Color="#C2071220" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <!-- 首尾预留自绘标题栏和 MiniPlayer，高斯背景会连续铺到窗口边缘。 -->
    <Grid RowDefinitions="44,58,*,88">
      <Grid Grid.Row="1" Margin="26,0" ColumnDefinitions="Auto,*,Auto,Auto">
        <Button Theme="{StaticResource SkyIconButtonTheme}" Classes="immersive-icon"
                Command="{Binding DataContext.ClosePlayerCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                Content="&#xE72B;" ToolTip.Tip="返回" Foreground="White"
                VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource SkyBrushAccent}" />
          <TextBlock Text="{Binding PlayerPageTitle}" Foreground="#D9FFFFFF" FontSize="12"
                     FontWeight="SemiBold" />
        </StackPanel>
        <Button Grid.Column="2" Theme="{StaticResource SkyIconButtonTheme}" Classes="immersive-icon"
                IsVisible="{Binding ShowsLyrics}" Click="ImportLyrics_OnClick"
                Content="&#xE8E5;" Foreground="White" ToolTip.Tip="导入本地歌词" />
        <Button Grid.Column="3" Theme="{StaticResource SkyIconButtonTheme}" Classes="immersive-icon" Content="&#xE712;"
                Foreground="White" IsHitTestVisible="False" Opacity="0.62"
                ToolTip.Tip="更多功能待接入" VerticalAlignment="Center" />
      </Grid>

      <Grid Grid.Row="2" Margin="64,18,64,28" MaxWidth="1320" HorizontalAlignment="Center">
        <Grid IsVisible="{Binding ShowsLyrics}" ColumnDefinitions="0.9*,1.15*" ColumnSpacing="62">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
            <Border Width="350" Height="350" CornerRadius="18"
                    Background="#24FFFFFF" BorderBrush="#32FFFFFF" BorderThickness="1"
                    BoxShadow="0 18 46 0 #70000000" ClipToBounds="True">
              <Image Source="{Binding CurrentItem.Cover}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="9">
              <TextBlock Text="{Binding PositionText}" Foreground="#B8FFFFFF" FontSize="11" />
              <Border Width="42" Height="1" Background="#54FFFFFF" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DurationText}" Foreground="#78FFFFFF" FontSize="11" />
            </StackPanel>
          </StackPanel>

          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" VerticalAlignment="Stretch">
            <TextBlock Text="{Binding CurrentItem.Title, FallbackValue=尚未选择歌曲}"
                       Foreground="White" FontSize="34" FontWeight="Bold"
                       TextWrapping="Wrap" MaxLines="2" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="9" Margin="0,8,0,22">
              <TextBlock Text="{Binding CurrentItem.Artist, FallbackValue=猫橘咪音乐}"
                         Foreground="#D4FFFFFF" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="·" Foreground="#68FFFFFF" FontSize="14" />
              <TextBlock Text="{Binding CurrentItem.Album, FallbackValue=本地音乐}"
                         Foreground="#92FFFFFF" FontSize="14" />
            </StackPanel>
            <Grid Grid.Row="2">
              <controls:LyricsView IsVisible="{Binding HasLyrics}" />
              <StackPanel IsVisible="{Binding HasNoLyrics}" HorizontalAlignment="Left"
                          VerticalAlignment="Center" Spacing="13" MaxWidth="360">
                <TextBlock Text="暂无歌词" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="导入 LRC 或 TXT 后，可按时间轴滚动和跳转。"
                           Foreground="#A8FFFFFF" FontSize="13" TextWrapping="Wrap" />
                <Button Theme="{StaticResource SkyPrimaryCommandButtonTheme}"
                        Click="ImportLyrics_OnClick" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons" />
                    <TextBlock Text="导入本地歌词" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
        <controls:MidiPianoRoll IsVisible="{Binding IsMidi}"
                                Notes="{Binding MidiNotes}" PositionSeconds="{Binding PositionSeconds}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
