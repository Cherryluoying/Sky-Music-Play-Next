<!-- 模块：SkyMusic.App 页面视图 KeyMappingView -->
<UserControl x:Class="SkyMusic.App.Views.KeyMappingView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SkyMusic.App.Controls">
  <Grid RowDefinitions="56,*">
    <controls:SkyWindowHeader Title="按键映射" ShowForward="True" />
    <Grid Grid.Row="1" ColumnDefinitions="250,20,*" Margin="28,18,28,28">
      <Grid RowDefinitions="Auto,10,*,12,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="映射方案" Classes="sky-section-title" />
          <Button Grid.Column="1" Theme="{StaticResource SkyIconButtonTheme}" Content="&#xE710;"
                  Command="{Binding NewCommand}" ToolTip.Tip="新建映射" />
        </Grid>
        <ListBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="8,8" Spacing="3">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <TextBlock Text="目标：" Classes="sky-caption" />
                  <TextBlock Text="{Binding ProcessNames}" Classes="sky-caption"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="4" Theme="{StaticResource SkyCommandButtonTheme}" Command="{Binding DeleteCommand}"
                IsEnabled="{Binding CanEditProfile}" Content="删除当前方案" />
      </Grid>

      <Border Grid.Column="2" Background="{StaticResource SkyBrushSurface}" BorderBrush="{StaticResource SkyBrushBorder}"
              BorderThickness="1" CornerRadius="{StaticResource SkyCornerCard}" Padding="18">
        <Grid RowDefinitions="Auto,10,Auto,10,Auto,10,Auto,10,*">
          <Grid ColumnDefinitions="*,14,*">
            <StackPanel>
              <TextBlock Text="方案名称" Classes="sky-caption" Margin="0,0,0,6" />
              <TextBox Text="{Binding MappingName}" IsEnabled="{Binding CanEditProfile}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="目标进程名（可选）" Classes="sky-caption" Margin="0,0,0,6" />
              <TextBox Text="{Binding ProcessNames}" IsEnabled="{Binding CanEditProfile}"
                       PlaceholderText="例如：Sky, GenshinImpact" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource SkyBrushAccentSoft}"
                  CornerRadius="{StaticResource SkyCornerMedium}" Padding="12,9">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding SelectedProfileDescription}" Classes="sky-secondary" TextWrapping="Wrap" />
              <TextBlock Text="目标进程名用于自动选择游戏窗口；留空时需要在演奏任务中手动选择窗口。"
                         Classes="sky-caption" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="4" ColumnDefinitions="*,Auto,8,Auto">
            <TextBlock Text="键位" Classes="sky-section-title" VerticalAlignment="Center" />
            <Button Grid.Column="1" Theme="{StaticResource SkyCommandButtonTheme}" Command="{Binding AddEntryCommand}"
                    IsEnabled="{Binding CanEditProfile}" Content="添加键位" />
            <Button Grid.Column="3" Theme="{StaticResource SkyPrimaryCommandButtonTheme}" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanEditProfile}" Content="保存方案" />
          </Grid>

          <TextBlock Grid.Row="6" Text="{Binding StatusText}" Classes="sky-secondary" TextWrapping="Wrap" />

          <ScrollViewer Grid.Row="8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Grid ColumnDefinitions="74,150,180,120,*" Margin="0,0,0,4">
                <TextBlock Text="音符" Classes="sky-caption" />
                <TextBlock Grid.Column="1" Text="MIDI 音符号（21-108）" Classes="sky-caption" />
                <TextBlock Grid.Column="2" Text="Windows 扫描码" Classes="sky-caption" />
                <TextBlock Grid.Column="3" Text="特殊键标记" Classes="sky-caption" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="74,150,180,120,*" MinHeight="44">
                    <TextBlock Text="{Binding NoteName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Minimum="21" Maximum="108" Value="{Binding MidiNote}"
                                   IsEnabled="{Binding DataContext.CanEditProfile, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                   Margin="0,4,10,4" ToolTip.Tip="要演奏的 MIDI 音符编号，中央 C 为 60" />
                    <NumericUpDown Grid.Column="2" Minimum="1" Maximum="65535" Value="{Binding ScanCode}"
                                   IsEnabled="{Binding DataContext.CanEditProfile, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                   Margin="0,4,10,4" ToolTip.Tip="Windows 键盘扫描码，不是字符或虚拟键码" />
                    <CheckBox Grid.Column="3" IsChecked="{Binding IsExtended}" IsEnabled="{Binding DataContext.CanEditProfile, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              Content="扩展键" VerticalAlignment="Center" ToolTip.Tip="方向键、数字键盘等需要扩展标志的按键" />
                    <Button Grid.Column="4" Theme="{StaticResource SkyIconButtonTheme}" Content="&#xE74D;" HorizontalAlignment="Right"
                            IsEnabled="{Binding DataContext.CanEditProfile, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}" ToolTip.Tip="删除键位" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
