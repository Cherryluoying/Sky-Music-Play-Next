<!-- 模块：SkyMusic.App 页面视图 GameComposerView -->
<UserControl x:Class="SkyMusic.App.Views.GameComposerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:composer="using:SkyMusic.App.Views.Composer"
             Focusable="True"
             KeyDown="Composer_OnKeyDown">
  <Grid Background="{StaticResource ComposerBrushCanvas}" RowDefinitions="44,56,*,202,36"
        ClipToBounds="True">
    <composer:ComposerToolbar />
    <composer:ComposerSongHeader Grid.Row="1" />

    <Grid Grid.Row="2" ColumnDefinitions="210,*" MinHeight="0" ClipToBounds="True">
      <composer:ComposerTrackRail />
      <composer:ComposerSheetEditor Grid.Column="1" />
    </Grid>

    <composer:ComposerGameKeyboard Grid.Row="3" />
    <composer:ComposerTransport Grid.Row="4" />

    <composer:ComposerSettingsPanel Grid.Row="1" Grid.RowSpan="3"
                                    Margin="0,12,14,12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding IsSettingsOpen}" />
  </Grid>
</UserControl>
