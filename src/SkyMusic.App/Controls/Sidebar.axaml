<!-- 模块：SkyMusic.App 自定义控件 Sidebar -->
<UserControl x:Class="SkyMusic.App.Controls.Sidebar"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SkyMusic.App.Controls"
             xmlns:vm="using:SkyMusic.App.ViewModels">
  <UserControl.Resources>
    <DataTemplate x:Key="NavigationItemTemplate" DataType="vm:NavigationItemViewModel">
      <controls:SkyNavigationItem Label="{Binding Label}" Glyph="{Binding Glyph}"
                                  IsSelected="{Binding IsSelected}"
                                  Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                  CommandParameter="{Binding}" />
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="{StaticResource SkyBrushSidebar}">
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
        <StackPanel Margin="12,5,12,11" Spacing="{StaticResource SkyNavigationGap}">
          <TextBlock Text="创作" Classes="sky-navigation-group" Margin="10,5,0,3" />
          <controls:SkyNavigationItem Label="创作工作区" Glyph="&#xE70F;"
                                      Command="{Binding OpenWorkbenchCommand}" />

          <TextBlock Text="音乐" Classes="sky-navigation-group" Margin="10,8,0,3" />
          <ItemsControl ItemsSource="{Binding DiscoveryNavigationItems}"
                        ItemTemplate="{StaticResource NavigationItemTemplate}" />

          <TextBlock Text="演奏" Classes="sky-navigation-group" Margin="10,8,0,3" />
          <ItemsControl ItemsSource="{Binding PerformanceNavigationItems}"
                        ItemTemplate="{StaticResource NavigationItemTemplate}" />

          <TextBlock Text="工具" Classes="sky-navigation-group" Margin="10,8,0,3" />
          <ItemsControl ItemsSource="{Binding ToolNavigationItems}"
                        ItemTemplate="{StaticResource NavigationItemTemplate}" />

          <TextBlock Text="我的音乐" Classes="sky-navigation-group" Margin="10,8,0,3" />
          <ItemsControl ItemsSource="{Binding MusicNavigationItems}"
                        ItemTemplate="{StaticResource NavigationItemTemplate}" />
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="1" Padding="12,8,12,12">
        <controls:SkyNavigationItem Label="{Binding SettingsNavigationItem.Label}"
                                    Glyph="{Binding SettingsNavigationItem.Glyph}"
                                    IsSelected="{Binding SettingsNavigationItem.IsSelected}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{Binding SettingsNavigationItem}" />
      </Border>
    </Grid>
  </Border>
</UserControl>
