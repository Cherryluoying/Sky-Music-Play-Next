<!-- 模块：SkyMusic.App 自定义控件 SkyNavigationItem -->
<UserControl x:Class="SkyMusic.App.Controls.SkyNavigationItem"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button Theme="{StaticResource SkyNavigationItemTheme}"
          Classes.selected="{Binding IsSelected, ElementName=Root}"
          Command="{Binding Command, ElementName=Root}"
          CommandParameter="{Binding CommandParameter, ElementName=Root}">
    <Grid ColumnDefinitions="27,*">
      <TextBlock Text="{Binding Glyph, ElementName=Root}"
                 FontFamily="Segoe Fluent Icons" FontSize="16"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding Label, ElementName=Root}"
                 FontSize="12" FontWeight="Medium"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                 VerticalAlignment="Center" />
    </Grid>
  </Button>
</UserControl>
