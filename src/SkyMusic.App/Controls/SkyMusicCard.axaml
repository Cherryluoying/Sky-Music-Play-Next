<!-- 模块：SkyMusic.App 自定义控件 SkyMusicCard -->
<UserControl x:Class="SkyMusic.App.Controls.SkyMusicCard"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button Theme="{StaticResource SkyMusicCardTheme}"
          Command="{Binding PlayCommand}" ToolTip.Tip="播放">
    <Grid RowDefinitions="172,*">
      <Border CornerRadius="{StaticResource SkyCornerCard}"
              Background="{StaticResource SkyBrushPlaceholder}" ClipToBounds="True">
        <Grid>
          <Image Source="{Binding Cover}" Stretch="UniformToFill" />
          <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,8,8" Padding="6,3" CornerRadius="{StaticResource SkyCornerSmall}"
                  Background="#B319202B">
            <TextBlock Text="{Binding DurationText}" Classes="sky-caption" Foreground="White" />
          </Border>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="6,9,6,0" Spacing="3">
        <TextBlock Text="{Binding Title}" Classes="sky-card-title"
                   MaxLines="1" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Artist}" Classes="sky-secondary" FontSize="11"
                   MaxLines="1" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>
  </Button>
</UserControl>
