<!-- 模块：SkyMusic.App 自定义控件 LyricsView -->
<UserControl x:Class="SkyMusic.App.Controls.LyricsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SkyMusic.App.ViewModels">
  <UserControl.Styles>
    <Style Selector="ListBox.lyrics">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.lyrics ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.lyrics ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.lyric-time">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#8FFFFFFF" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Button.lyric-time:pointerover">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <ListBox x:Name="LyricsList" Classes="lyrics"
           ItemsSource="{Binding Lyrics}"
           SelectedIndex="{Binding CurrentLyricIndex, Mode=OneWay}"
           SelectionMode="Single"
           PointerWheelChanged="LyricsList_OnPointerWheelChanged"
           ScrollViewer.VerticalScrollBarVisibility="Hidden">
    <ListBox.ItemTemplate>
      <DataTemplate DataType="vm:LyricLineViewModel">
        <Grid ColumnDefinitions="58,*" Margin="0,0,18,24" MinHeight="38">
          <Grid VerticalAlignment="Stretch">
            <Border Width="1" Background="#24FFFFFF" HorizontalAlignment="Right" Margin="0,0,7,0" />
            <Button Classes="lyric-time" Content="{Binding TimestampText}"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="Timeline_OnClick" ToolTip.Tip="跳转到此句" />
            <Border Width="5" Height="5" CornerRadius="3" Background="#8FC5E8FF"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" />
          </Grid>
          <TextBlock Grid.Column="1" Text="{Binding Text}"
                     Foreground="{Binding Foreground}"
                     FontSize="{Binding FontSize}"
                     FontWeight="{Binding LineFontWeight}"
                     Opacity="{Binding Opacity}"
                     TextWrapping="Wrap"
                     TextAlignment="Left"
                     HorizontalAlignment="Stretch"
                     Margin="18,0,0,0"
                     MinHeight="32">
            <TextBlock.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.26" />
                <DoubleTransition Property="FontSize" Duration="0:0:0.26" />
                <BrushTransition Property="Foreground" Duration="0:0:0.26" />
              </Transitions>
            </TextBlock.Transitions>
          </TextBlock>
        </Grid>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
