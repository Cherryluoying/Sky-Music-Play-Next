<!-- 模块：沉浸歌词，固定排版、当前句居中、悬停显示跳转时间。 -->
<UserControl x:Class="SkyMusic.App.Controls.LyricsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SkyMusic.App.ViewModels">
  <UserControl.Styles>
    <!-- 整句可点击；透明模板避免默认按钮选中背景影响歌词。 -->
    <Style Selector="Button.lyric-line">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,12,8,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Stretch" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TextBlock.lyric-time">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Foreground" Value="#B8FFFFFF" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.lyric-line:pointerover TextBlock.lyric-time, Button.lyric-line:focus-visible TextBlock.lyric-time">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="LyricsScroll" MinWidth="0" ClipToBounds="True"
                VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                SizeChanged="LyricsScroll_OnSizeChanged" PointerExited="LyricsScroll_OnPointerExited">
    <ScrollViewer.OpacityMask>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="Transparent" Offset="0" />
        <GradientStop Color="Black" Offset="0.22" />
        <GradientStop Color="Black" Offset="0.76" />
        <GradientStop Color="Transparent" Offset="1" />
      </LinearGradientBrush>
    </ScrollViewer.OpacityMask>
    <!-- 首尾留白属于滚动内容，使首句和末句也能滚动到中心。 -->
    <Border x:Name="LyricsPadding">
      <ItemsControl x:Name="LyricsItems" ItemsSource="{Binding Lyrics}" HorizontalAlignment="Stretch">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:LyricLineViewModel">
            <Button Classes="lyric-line" Click="Timeline_OnClick">
              <Grid ColumnDefinitions="*,52" MinWidth="0">
                <TextBlock Classes="lyric-copy" Text="{Binding Text}" Foreground="White"
                           FontSize="{Binding FontSize}" FontWeight="{Binding LineFontWeight}"
                           Opacity="{Binding Opacity}" TextWrapping="Wrap" TextAlignment="Left"
                           RenderTransformOrigin="0%,50%" VerticalAlignment="Center" MinHeight="36">
                  <TextBlock.RenderTransform>
                    <ScaleTransform ScaleX="{Binding VisualScale}" ScaleY="{Binding VisualScale}">
                      <ScaleTransform.Transitions>
                        <Transitions>
                          <DoubleTransition Property="ScaleX" Duration="0:0:0.44" Easing="CubicEaseOut" />
                          <DoubleTransition Property="ScaleY" Duration="0:0:0.44" Easing="CubicEaseOut" />
                        </Transitions>
                      </ScaleTransform.Transitions>
                    </ScaleTransform>
                  </TextBlock.RenderTransform>
                  <TextBlock.Transitions>
                    <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.36" /></Transitions>
                  </TextBlock.Transitions>
                </TextBlock>
                <TextBlock Grid.Column="1" Classes="lyric-time" Text="{Binding TimestampText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock.Transitions>
                    <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2" /></Transitions>
                  </TextBlock.Transitions>
                </TextBlock>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </ScrollViewer>
</UserControl>
