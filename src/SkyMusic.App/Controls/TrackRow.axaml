<!-- 模块：SkyMusic.App 自定义控件 TrackRow -->
<UserControl x:Class="SkyMusic.App.Controls.TrackRow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid ColumnDefinitions="36,50,*,130,52,40,40">
    <TextBlock Text="{Binding DisplayIndexText}" Classes="sky-caption" VerticalAlignment="Center" HorizontalAlignment="Center" />
    <Button Grid.Column="1" Grid.ColumnSpan="4" Theme="{StaticResource SkyTrackRowTheme}" Classes.selected="{Binding IsSelected}"
            DoubleTapped="Track_OnDoubleTapped" ToolTip.Tip="双击播放">
      <Grid ColumnDefinitions="50,*,130,52">
        <Border Width="48" Height="48" CornerRadius="{StaticResource SkyCornerMedium}"
              Background="{StaticResource SkyBrushPlaceholder}" ClipToBounds="True">
          <Image Source="{Binding Cover}" Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="{Binding Title}" Classes="sky-card-title" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding ArtistAlbumText}" ToolTip.Tip="{Binding ArtistAlbumText}"
                     Classes="sky-secondary" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Author}" Classes="sky-secondary" FontSize="11"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="3" Text="{Binding DurationText}" Classes="sky-caption" FontSize="11"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Button>
    <Button Grid.Column="5" Theme="{StaticResource SkyIconButtonTheme}" Command="{Binding ToggleFavoriteCommand}"
            Content="{Binding FavoriteGlyph}" ToolTip.Tip="喜欢" Classes="favorite-button"
            Classes.favorite-active="{Binding IsFavorite}" />
    <Button Grid.Column="6" Theme="{StaticResource SkyIconButtonTheme}" Command="{Binding PlayNextCommand}"
            IsVisible="{Binding CanPlayNext}" Content="&#xE893;" ToolTip.Tip="添加到下一首" />
  </Grid>
</UserControl>
